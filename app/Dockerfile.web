# Builds the Flutter web bundle and serves it with nginx.
# Build args bake the production API URL and (optional) reverse-proxy Basic auth.
# Build context must be the REPO ROOT (needs app/ and web/nginx.conf).
FROM ghcr.io/cirruslabs/flutter:stable AS build
ARG API_BASE_URL=http://localhost:8090
ARG API_AUTH=
WORKDIR /build
COPY app/pubspec.yaml ./
RUN flutter pub get
COPY app/ ./
RUN flutter build web --release --pwa-strategy=none \
      --dart-define=API_BASE_URL=${API_BASE_URL} \
      --dart-define=API_AUTH=${API_AUTH}

FROM nginx:alpine
COPY --from=build /build/build/web /usr/share/nginx/html
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
